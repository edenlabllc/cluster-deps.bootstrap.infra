# This file defines the globals configuration list for values different releases, 
# is located in the environment directory of a specific releases scope: etc/<releases scope>/<environment>/globals.yaml.gotmpl.
# This configuration allows you to use the same values in value files of different releases only in the same scope.

# configs - enumeration of configurations divided into sets related to Kubernetes ConfigMaps
configs:
  linkerd:
    # enable/disable linkerd-await at runtime: true|false
    await: true
    # enable/disable linkerd sidecar injection: enabled|disabled
    inject: enabled

# envs - enumeration of environment variables divided into sets related to Kubernetes environment variables for container
envs: {}

# hooks - enumeration of environment variables divided into sets related to helmfile hooks arguments
hooks:
  aws-cluster:
    postsync-wait-aws-cluster-ready:
      events:
        - postsync
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postsync-wait-aws-cluster-ready.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    0-preuninstall-postuninstall-delete-aws-cluster:
      events:
        - preuninstall
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/preuninstall-postuninstall-delete-aws-cluster.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
        - '{{`{{ eq .Event.Name "postuninstall" | ternary "true" "false" }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    1-postuninstall-delete-namespace:
      events:
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postuninstall-delete-namespace.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
  aws-iam-provision:
    postsync-wait-aws-iam-provision-ready:
      events:
        - postsync
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postsync-wait-aws-iam-provision-ready.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
  azure-cluster:
    postsync-wait-azure-cluster-ready:
      events:
        - postsync
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postsync-wait-azure-cluster-ready.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    0-preuninstall-postuninstall-delete-azure-cluster:
      events:
        - preuninstall
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/preuninstall-postuninstall-delete-azure-cluster.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
        - '{{`{{ eq .Event.Name "postuninstall" | ternary "true" "false" }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    1-postuninstall-delete-namespace:
      events:
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postuninstall-delete-namespace.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
  gcp-cluster:
    postsync-wait-gcp-cluster-ready:
      events:
        - postsync
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postsync-wait-gcp-cluster-ready.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    0-preuninstall-postuninstall-delete-gcp-cluster:
      events:
        - preuninstall
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/preuninstall-postuninstall-delete-gcp-cluster.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
        - '{{`{{ eq .Event.Name "postuninstall" | ternary "true" "false" }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    1-postuninstall-delete-namespace:
      events:
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postuninstall-delete-namespace.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
  onprem-cluster:
    postsync-wait-onprem-cluster-ready:
      events:
        - postsync
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postsync-wait-onprem-cluster-ready.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    0-preuninstall-postuninstall-delete-onprem-cluster:
      events:
        - preuninstall
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/preuninstall-postuninstall-delete-onprem-cluster.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
        - '{{`{{ .Release.Name }}`}}'
        - '{{`{{ eq .Event.Name "postuninstall" | ternary "true" "false" }}`}}'
    # weight prefix is needed for correct hook execution order for the same event because they are sorted alphabetically during rendering
    1-postuninstall-delete-namespace:
      events:
        - postuninstall
      showlogs: true
      command: "{{`{{ .Release.Labels.bin }}`}}/postuninstall-delete-namespace.sh"
      args:
        - '{{`{{ .Release.Namespace }}`}}'
