# Default values for clusterctl-config.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.

certManager: {}
#  url: "https://github.com/cert-manager/cert-manager/releases/latest/cert-manager.yaml"
#  version: v1.16.0
#  timeout: 10m

images: {}
#  all:
#    repository: myorg.io/local-repo
#  cert-manager:
#    tag: v1.16.0

# Read HELMFILE_<TENANT>_PATHS env (JSON list of {"path": "..."} objects) and take
# the directory of the first entry, stripping the trailing helmfile.yaml.gotmpl.
# Falls back to a relative path if the env var is unset or the list is empty.
{{- $helmfilePaths := env (printf "HELMFILE_%s_PATHS" (env "TENANT" | upper)) | fromJson }}
{{- $path := "" }}
{{- if $helmfilePaths }}
{{- $path = (first $helmfilePaths).path | trimSuffix "helmfile.yaml.gotmpl" }}
{{- end }}
overridesFolder: {{ $path }}etc/deps/{{ .Environment.Name }}/values/cluster-api/overrides

# AWS path pinned for K8s 1.36 validation.
# Other providers intentionally not bumped in this release.
providers:
  - name: cluster-api
    type: CoreProvider
    url: https://github.com/kubernetes-sigs/cluster-api/releases/v1.13.5/core-components.yaml
  - name: kubeadm
    type: BootstrapProvider
    url: https://github.com/kubernetes-sigs/cluster-api/releases/v1.13.5/bootstrap-components.yaml
  - name: kubeadm
    type: ControlPlaneProvider
    url: https://github.com/kubernetes-sigs/cluster-api/releases/v1.13.5/control-plane-components.yaml
  - name: aws
    type: InfrastructureProvider
    url: https://github.com/edenlabllc/cluster-api-provider-aws/releases/v2.12.2/infrastructure-components.yaml
  - name: azure
    type: InfrastructureProvider
    url: https://github.com/kubernetes-sigs/cluster-api-provider-azure/releases/v1.26.0/infrastructure-components.yaml
  - name: gcp
    type: InfrastructureProvider
    url: https://github.com/edenlabllc/cluster-api-provider-gcp/releases/v1.13.1/infrastructure-components.yaml
  - name: onprem
    type: InfrastructureProvider
    url: https://github.com/edenlabllc/on-premise-configurator.operators.infra/releases/v0.3.1/infrastructure-components.yaml

variables: {}
#  FOO: value
